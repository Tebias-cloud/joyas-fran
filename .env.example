# Public Supabase configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only Supabase credentials
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
ADMIN_EMAIL=admin@example.com

# Canonical public URL (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Mercado Pago server credentials
MP_ACCESS_TOKEN=your-access-token
MP_WEBHOOK_SECRET=your-webhook-secret

# Gemini server credential
GEMINI_API_KEY=your-gemini-key

# Isolated E2E environment only
TEST_ADMIN_EMAIL=test-admin@example.com
TEST_ADMIN_PASSWORD=replace-me
